# Dependencies
node_modules/

# Runtime data
server/data/

# Local env (commit only .env.example)
server/.env
server/.env.*
!server/.env.example

# Build output
server/dist/
server/public/admin-client/
app/LoomClone.xcodeproj/
# ...except the SwiftPM resolver state. The xcodeproj is generated, but
# Package.resolved is the only record of which *transitive* versions the app
# was built against — project.yml pins argmax-oss-swift exactly, and this pins
# everything underneath it (swift-transformers, swift-argument-parser, …).
# Without it a clean checkout resolves the graph afresh.
!app/LoomClone.xcodeproj/
app/LoomClone.xcodeproj/*
!app/LoomClone.xcodeproj/project.xcworkspace/
app/LoomClone.xcodeproj/project.xcworkspace/*
!app/LoomClone.xcodeproj/project.xcworkspace/xcshareddata/
app/LoomClone.xcodeproj/project.xcworkspace/xcshareddata/*
!app/LoomClone.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
app/LoomClone.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!app/LoomClone.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
app/build/

# Xcode
*.xcuserdata/
DerivedData/
*.xcworkspace/
buildServer.json
*.profraw

# macOS
.DS_Store

.playwright-cli

docs/tasks-todo/temporary/
